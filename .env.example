# =============================================================================
# Copia a .env.local para desarrollo:  cp .env.example .env.local
#
# Aquí NO va ninguna credencial. Todo lo que empieza por NEXT_PUBLIC_ viaja al
# navegador, así que es público por definición.
#
# En particular: el AGENT_API_KEY del endpoint Bearer del agente NO pertenece a
# este repo, en ninguna forma. La demo del sitio habla con /api/chat, que no
# lleva credencial y está limitado por IP en el backend.
# =============================================================================

# Agente de CV desplegado. Sin barra final.
# Si no se define, se usa el valor por defecto de src/lib/site.ts.
NEXT_PUBLIC_AGENT_URL=https://cv-agent.mangopond-59d644ac.eastus2.azurecontainerapps.io
